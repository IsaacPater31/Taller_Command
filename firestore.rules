rules_version = '2';

// Cualquiera puede leer el ranking y agregar un puntaje válido.
// Nadie puede editar ni borrar desde la página.
service cloud.firestore {
  match /databases/{database}/documents {
    match /ranking/{id} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name', 'total', 'diagram', 'right', 'of', 'time', 'date'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1700
        && request.resource.data.diagram is int
        && request.resource.data.diagram >= 0
        && request.resource.data.diagram <= 500
        && request.resource.data.right is int
        && request.resource.data.right >= 0
        && request.resource.data.right <= 8
        && request.resource.data.of == 8
        && request.resource.data.time is int
        && request.resource.data.time >= 0
        && request.resource.data.date is int;

      allow update, delete: if false;
    }
  }
}
